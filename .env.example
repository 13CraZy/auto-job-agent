# ==============================================================================
# AUTO JOB HUNTER & ALERTS BOT — CONFIGURACIÓN DE ENTORNO (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PROVEEDORES DE INTELIGENCIA ARTIFICIAL (Para filtrado y triaje de vacantes)
# ------------------------------------------------------------------------------
# Obtén tu clave gratuita en https://console.groq.com (Recomendado: ultra-rápido)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Obtén tu clave gratuita en https://aistudio.google.com/app/apikey (Opcional)
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# Obtén tu clave en https://openrouter.ai (Opcional - Respaldo)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here

# OpenAI API Key estándar (Opcional)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. CANAL DE TELEGRAM (Notificaciones inmediatas a tu celular)
# ------------------------------------------------------------------------------
# 1. Abre Telegram y escribe a @BotFather para crear tu bot y obtener el token.
# 2. Escribe a @userinfobot para obtener tu Chat ID numérico personal.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ENABLE_TELEGRAM=true

# ------------------------------------------------------------------------------
# 3. CANAL DE CORREO ELECTRÓNICO (SMTP) (Opcional)
# ------------------------------------------------------------------------------
# Para Gmail: Activa 2FA y genera una Contraseña de Aplicación (16 letras) en:
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=xxxx_xxxx_xxxx_xxxx
NOTIFICATION_EMAIL=tu_correo_destino@gmail.com
ENABLE_EMAIL=false

# ------------------------------------------------------------------------------
# 4. CONFIGURACIÓN DE BÚSQUEDA
# ------------------------------------------------------------------------------
MAX_HOURS_OLD=36.0
DEFAULT_COUNTRY=Mexico
